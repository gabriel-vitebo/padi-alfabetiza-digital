# Copie para .env. Nunca versione credenciais reais.
APP_ENV=local
# LOCAL: substitua a senha abaixo e na URL pelo mesmo valor.
POSTGRESQL_DATABASE=padi
POSTGRESQL_USERNAME=padi
POSTGRESQL_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRESQL_PORT=5432
DATABASE_URL=postgresql://padi:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/padi
# HOMOLOG/PRODUCTION: copie a URL do transaction pooler do respectivo Supabase.
# Prisma 7: prisma.config.ts.datasource.url recebe DATABASE_MIGRATION_URL.
# URL direta ou session pooler do MESMO projeto; obrigatória remotamente.
# Vazio usa DATABASE_URL somente local. URLs remotas: sslmode=verify-full.
DATABASE_MIGRATION_URL=
# Não use NUXT_PUBLIC_ para nenhuma conexão ou segredo.

# Somente no executor administrativo remoto, após conferir o projeto Supabase:
# CONFIRM_DATABASE_ENV=homolog (ou production). Não necessário na Vercel runtime.
